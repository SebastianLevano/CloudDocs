# Copy to .env.local for local dev. Never commit real secrets.

# ============================================================
# Database
# ============================================================
# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL=postgres://clouddocs:clouddocs@localhost:5434/clouddocs

# Neon dev branch (production-shaped; use for integration tests)
# DATABASE_URL=postgres://<user>:<password>@<host>/<db>?sslmode=require

# ============================================================
# Auth
# ============================================================
# EdDSA keypair for JWT (jose). Generate with:
#   pnpm tsx tools/scripts/generate-jwt-keys.ts
# In Lambda, these come from AWS Secrets Manager.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ============================================================
# AWS (Phase 1+)
# ============================================================
AWS_REGION=us-east-1
AWS_PROFILE=clouddocs-dev
