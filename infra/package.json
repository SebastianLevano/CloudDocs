{
  "name": "@clouddocs/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for CloudDocs AI. Lives outside the pnpm workspace on purpose: deploy tooling shouldn't pull workspace deps and vice versa.",
  "bin": {
    "clouddocs-infra": "bin/clouddocs.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval=any-change",
    "deploy:dev": "cdk deploy --all --require-approval=any-change --context stage=dev",
    "bootstrap": "cdk bootstrap",
    "destroy": "cdk destroy --all",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.180.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.180.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
